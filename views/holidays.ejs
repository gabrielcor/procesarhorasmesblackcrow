<%- include('partials/header') %>
<section class="card">
  <h1>Feriados globales</h1>
  <% if (message) { %><p class="info"><%= message %></p><% } %>

  <form method="get" action="/admin/holidays" class="form-inline">
    <label>Ano</label>
    <input type="number" name="year" value="<%= year %>" min="2000" max="2100" />
    <button type="submit">Ver</button>
  </form>

  <form method="post" action="/admin/holidays" class="form-grid">
    <label>Fecha</label>
    <input type="date" name="holidayDate" required />
    <label>Nombre</label>
    <input type="text" name="holidayName" required />
    <button type="submit">Agregar</button>
  </form>
</section>

<section class="card">
  <table>
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Nombre</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% holidays.forEach((h) => { %>
        <tr>
          <td><%= formatDate(h.holiday_date) %></td>
          <td><%= h.holiday_name %></td>
          <td>
            <form method="post" action="/admin/holidays/<%= h.holiday_id %>/delete">
              <input type="hidden" name="year" value="<%= year %>" />
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
