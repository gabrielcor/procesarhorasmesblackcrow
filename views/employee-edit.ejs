<%- include('partials/header') %>
<section class="card employee-page employee-edit">
  <a href="/admin/employees">← Volver a Empleados</a>
  <h1>Editar empleado</h1>
  <p class="muted">Actualiza los datos de <strong><%= employee.display_name %></strong>.</p>
  <p class="employee-policy">Cambiar la regla actualiza también el cálculo de los reportes históricos de este empleado.</p>
  <form method="post" action="/admin/employees/<%= employee.employee_id %>/update" class="form-grid">
    <input type="hidden" name="csrfToken" value="<%= employeeCsrfToken %>" />
    <%- include('partials/employee-fields', { editing: true }) %>
    <div class="actions-row">
      <button type="submit">Guardar cambios</button>
      <a href="/admin/employees">Cancelar</a>
    </div>
  </form>
</section>
<script src="/employee-rules.js" defer></script>
<%- include('partials/footer') %>
