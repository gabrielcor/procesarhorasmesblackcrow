<%- include('partials/header') %>
<section class="card">
  <h1>Asistencia mensual</h1>
  <% if (message) { %><p class="info"><%= message %></p><% } %>

  <form method="get" action="/attendance" class="form-inline">
    <label>Mes</label>
    <input type="month" name="month" value="<%= yearMonth %>" required />

    <% if (isAdmin) { %>
      <label>Empleado</label>
      <select name="employeeId">
        <option value="">Seleccione</option>
        <% employees.forEach((e) => { %>
          <option value="<%= e.employee_id %>" <%= Number(employeeId) === Number(e.employee_id) ? 'selected' : '' %>>#<%= e.employee_number %> - <%= e.display_name %></option>
        <% }) %>
      </select>
    <% } %>

    <button type="submit">Ver</button>
  </form>

  <% if (employeeId) { %>
    <p>
      <a href="/download?month=<%= yearMonth %>&employeeId=<%= employeeId %>">Descargar hoja del mes</a>
    </p>
  <% } %>
</section>

<% if (days && days.length > 0) { %>
<section class="card">
  <table class="attendance-table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Tipo</th>
        <th>Slots</th>
        <th>Minutos dia</th>
      </tr>
    </thead>
    <tbody>
      <% days.forEach((day) => { %>
        <tr>
          <td><%= formatDate(day.workDate) %></td>
          <td>
            <div class="day-type-labels">
              <% if (day.isHoliday) { %>
                <span class="day-chip holiday">Feriado (<%= day.holidayName %>)</span>
              <% } %>
              <% if (day.dayType === 'V') { %>
                <span class="day-chip vacation">Vacaciones</span>
              <% } else if (day.dayType === 'L') { %>
                <span class="day-chip leave">Licencia</span>
              <% } else if (!day.isHoliday) { %>
                <span class="day-chip normal">Normal</span>
              <% } %>
            </div>
            <% if (day.dayId) { %>
              <form method="post" action="/attendance/day/<%= day.dayId %>/type" class="day-type-actions">
                <input type="hidden" name="month" value="<%= yearMonth %>" />
                <input type="hidden" name="employeeId" value="<%= employeeId %>" />
                <% if (day.dayType !== 'V') { %>
                  <button type="submit" name="dayType" value="V" class="type-btn">V</button>
                <% } %>
                <% if (day.dayType !== 'L') { %>
                  <button type="submit" name="dayType" value="L" class="type-btn">L</button>
                <% } %>
                <% if (day.dayType !== 'N') { %>
                  <button type="submit" name="dayType" value="N" class="type-btn neutral">N</button>
                <% } %>
              </form>
            <% } %>
          </td>
          <td>
            <% if ((!day.visibleSlots || day.visibleSlots.length === 0) && day.dayId && day.missingSlotIndices && day.missingSlotIndices.length > 0) { %>
              <div class="empty-slot-actions">
                <button
                  type="button"
                  class="add-slot-btn"
                  data-target-class="day-<%= day.dayId %>-hidden-slot"
                  aria-label="Agregar slot"
                  title="Agregar slot"
                >+</button>
              </div>
            <% } %>

            <% (day.visibleSlots || []).forEach((slot, index) => { %>
              <%
                const saveFormId = `save-slot-${slot.slotId || ('day' + day.dayId + '-idx' + slot.slotIndex)}`;
                const deleteFormId = `del-slot-${slot.slotId}`;
              %>
              <form id="<%= saveFormId %>" method="post" action="<%= slot.slotId ? `/attendance/slot/${slot.slotId}` : `/attendance/day/${day.dayId}/slot/${slot.slotIndex}` %>" class="slot-form">
                <input type="hidden" name="month" value="<%= yearMonth %>" />
                <input type="hidden" name="employeeId" value="<%= employeeId %>" />
                <span>#<%= slot.slotIndex %></span>
                <input name="currentStartTime" value="<%= slot.currentStartTime || '' %>" placeholder="HH:mm" />
                <input name="currentEndTime" value="<%= slot.currentEndTime || '' %>" placeholder="HH:mm" />
                <div class="actions-row">
                  <button type="submit">Guardar</button>
                </div>
                <div class="slot-meta">
                  <small>
                    Orig: <%= slot.originalStartTime || '--:--' %> - <%= slot.originalEndTime || '--:--' %>
                    <%= slot.sourceNote ? `(${slot.sourceNote})` : '' %>
                  </small>
                  <button type="submit" form="<%= deleteFormId %>" class="remove-slot-btn" title="Eliminar slot">-</button>
                  <% if (index === day.visibleSlots.length - 1 && day.dayId && day.missingSlotIndices && day.missingSlotIndices.length > 0) { %>
                    <button
                      type="button"
                      class="add-slot-btn"
                      data-target-class="day-<%= day.dayId %>-hidden-slot"
                      aria-label="Agregar slot"
                      title="Agregar slot"
                    >+</button>
                  <% } %>
                </div>
              </form>
              <% if (slot.slotId) { %>
              <form id="<%= deleteFormId %>" method="post" action="/attendance/slot/<%= slot.slotId %>/delete" style="display:none">
                <input type="hidden" name="month" value="<%= yearMonth %>" />
                <input type="hidden" name="employeeId" value="<%= employeeId %>" />
              </form>
              <% } %>
            <% }) %>

            <% if (day.dayId && day.missingSlotIndices && day.missingSlotIndices.length > 0) { %>
              <% day.missingSlotIndices.forEach((slotIndex) => { %>
                <form method="post" action="/attendance/day/<%= day.dayId %>/slot/<%= slotIndex %>" class="slot-form slot-form-hidden day-<%= day.dayId %>-hidden-slot">
                  <input type="hidden" name="month" value="<%= yearMonth %>" />
                  <input type="hidden" name="employeeId" value="<%= employeeId %>" />
                  <span>#<%= slotIndex %></span>
                  <input name="currentStartTime" value="" placeholder="HH:mm" />
                  <input name="currentEndTime" value="" placeholder="HH:mm" />
                  <button type="submit">Guardar</button>
                  <div class="slot-meta">
                    <small>Nuevo slot</small>
                  </div>
                </form>
              <% }) %>
            <% } %>
          </td>
          <td><%= day.workedMinutes %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>

<% if (summary) { %>
<section class="card summary-grid">
  <div>Total minutos trabajados: <strong><%= summary.totalWorkedMinutes %></strong></div>
  <div>Minutos requeridos: <strong><%= summary.requiredMinutes %></strong></div>
  <div>Tolerancia mensual: <strong><%= summary.allowanceMinutes %></strong></div>
  <div>Minutos requeridos luego de tolerancia: <strong><%= summary.requiredAfterAllowance %></strong></div>
  <div>Saldo final: <strong class="<%= summary.balanceMinutes >= 0 ? 'positive' : 'negative' %>"><%= summary.balanceMinutes %></strong></div>
</section>
<% } %>

<script>
  document.querySelectorAll('.add-slot-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const className = button.getAttribute('data-target-class');
      const hiddenForms = Array.from(document.querySelectorAll(`.${className}.slot-form-hidden`));
      const nextHidden = hiddenForms.find((form) => form.style.display !== 'grid');

      if (!nextHidden) {
        button.style.display = 'none';
        return;
      }

      nextHidden.style.display = 'grid';
      const stillHidden = hiddenForms.some((form) => form.style.display !== 'grid');
      if (!stillHidden) {
        button.style.display = 'none';
      }
    });
  });
</script>

<%- include('partials/footer') %>
