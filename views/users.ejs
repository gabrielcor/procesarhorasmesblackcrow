<%- include('partials/header') %>
<section class="card">
  <h1>Usuarios</h1>
  <% if (message) { %><p class="info"><%= message %></p><% } %>

  <h2>Crear usuario</h2>
  <form method="post" action="/admin/users" class="form-grid">
    <label>Usuario</label>
    <input type="text" name="username" required />

    <label>Clave</label>
    <input type="password" name="password" required />

    <label>Empleado</label>
    <select name="employeeId">
      <option value="">Sin empleado (solo admin)</option>
      <% employees.forEach((employee) => { %>
        <option value="<%= employee.employee_id %>">#<%= employee.employee_number %> - <%= employee.display_name %></option>
      <% }) %>
    </select>

    <label class="inline-check"><input type="checkbox" name="isAdmin" /> Es administrador</label>
    <button type="submit">Guardar</button>
  </form>
</section>

<section class="card">
  <h2>Listado</h2>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Usuario</th>
        <th>Rol</th>
        <th>Empleado</th>
        <th>Activo</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach((u) => { %>
        <tr>
          <form method="post" action="/admin/users/<%= u.user_id %>/update">
            <td><%= u.user_id %></td>
            <td><input type="text" name="username" value="<%= u.username %>" required /></td>
            <td>
              <label class="inline-check"><input type="checkbox" name="isAdmin" <%= u.is_admin ? 'checked' : '' %> /> Admin</label>
            </td>
            <td>
              <select name="employeeId">
                <option value="">Sin empleado</option>
                <% employees.forEach((employee) => { %>
                  <option value="<%= employee.employee_id %>" <%= Number(u.employee_id) === Number(employee.employee_id) ? 'selected' : '' %>>#<%= employee.employee_number %> - <%= employee.display_name %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <label class="inline-check"><input type="checkbox" name="isActive" <%= u.is_active ? 'checked' : '' %> /> Activo</label>
            </td>
            <td>
              <div class="actions-row">
                <input type="password" name="password" placeholder="Nueva clave opcional" />
                <button type="submit">Actualizar</button>
                <% if (Number(u.user_id) !== Number(user.id)) { %>
                  <button
                    type="submit"
                    class="danger-btn"
                    formaction="/admin/users/<%= u.user_id %>/delete"
                    formnovalidate
                    onclick="return confirm('Eliminar usuario?');"
                  >Eliminar</button>
                <% } %>
              </div>
            </td>
          </form>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
